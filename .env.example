# Zephyr Hub core infrastructure
NUXT_DATABASE_URL=postgres://zephyr:replace-me@127.0.0.1:5432/zephyr_hub
NUXT_REDIS_URL=redis://127.0.0.1:6379/0

# 32-byte base64 key: openssl rand -base64 32
NUXT_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# At least 32 random characters, used to hash Hub Keys.
NUXT_HUB_KEY_PEPPER=replace-with-at-least-32-random-characters
# Independent keyring for decryptable Hub Keys. Do not reuse NUXT_ENCRYPTION_KEY.
NUXT_HUB_KEY_ENCRYPTION_ACTIVE_VERSION=v1
NUXT_HUB_KEY_ENCRYPTION_KEYS={"v1":"replace-with-base64-encoded-32-byte-key"}

# Used only to create the first administrator when admin_users is empty.
NUXT_ADMIN_USERNAME=admin
NUXT_ADMIN_PASSWORD=replace-with-a-long-random-password

# MinIO or S3-compatible object storage for encrypted request/response bodies.
NUXT_S3_ENDPOINT=http://127.0.0.1:9000
NUXT_S3_REGION=us-east-1
NUXT_S3_BUCKET=zephyr-hub-logs
NUXT_S3_ACCESS_KEY_ID=replace-with-access-key
NUXT_S3_SECRET_ACCESS_KEY=replace-with-secret-key
NUXT_S3_FORCE_PATH_STYLE=true
# MinIO local SSE-S3 master key name plus a 32-byte Base64 key.
MINIO_KMS_SECRET_KEY=zephyr-hub:replace-with-base64-encoded-32-byte-key

# Gateway behavior
NUXT_HUB_REQUEST_TIMEOUT_MS=120000
NUXT_HUB_CIRCUIT_FAILURE_THRESHOLD=3
NUXT_HUB_CIRCUIT_COOLDOWN_MS=30000
# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For.
# Transition example (US Hub trusts only the HK WireGuard peer): 10.20.0.1/32
NUXT_TRUSTED_PROXY_CIDRS=

# Prometheus and alerting. Generate independent random secrets.
NUXT_METRICS_TOKEN=replace-with-a-long-random-metrics-token
NUXT_OPERATIONS_TOKEN=replace-with-a-different-long-random-operations-token
NUXT_ALERT_WEBHOOK_URL=
NUXT_ALERT_WEBHOOK_SECRET=replace-with-a-webhook-signing-secret
NUXT_ALERT_FAILURE_RATE=0.2
NUXT_ALERT_MINIMUM_REQUESTS=20
NUXT_ALERT_STREAM_ABORT_RATE=0.1
NUXT_ALERT_FIRST_BYTE_MS=5000
NUXT_ALERT_PENDING_REQUESTS=100
NUXT_ALERT_MEMORY_RSS_BYTES=805306368
NUXT_ALERT_COOLDOWN_SECONDS=1800

# CLIProxyAPI Management API
NUXT_CPA_BASE_URL=http://127.0.0.1:8317
NUXT_CPA_MANAGEMENT_KEY=replace-with-cpa-management-key

# CPA Manager Plus Manager Server
NUXT_CPAMP_BASE_URL=http://127.0.0.1:18317
NUXT_CPAMP_ADMIN_KEY=replace-with-cpamp-admin-key

# Sub2API gateway (no admin key is required for quota queries)
NUXT_SUB2API_BASE_URL=http://127.0.0.1:8080
# Required only for the all-account quota dashboard.
NUXT_SUB2API_ADMIN_API_KEY=replace-with-sub2api-admin-api-key

# Used to create opaque public account IDs. At least 32 random characters.
NUXT_ACCOUNT_ID_SECRET=replace-with-at-least-32-random-characters
