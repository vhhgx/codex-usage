EDGE_PROBE_URL=https://hk-hub.example.com
EDGE_PROBE_HUB_KEY=zh-replace-with-dedicated-probe-key
EDGE_PROBE_MODEL=replace-with-low-cost-model
EDGE_PROBE_CONCURRENCY=3
EDGE_PROBE_TIMEOUT_MS=120000

# Optional image upload probe.
EDGE_PROBE_IMAGE=
EDGE_PROBE_IMAGE_MODEL=

# Generic JSON webhook. Failures notify by default; set true to send every result.
EDGE_PROBE_WEBHOOK_URL=
EDGE_PROBE_NOTIFY_ALWAYS=false
